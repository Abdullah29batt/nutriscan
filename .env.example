# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Firebase Admin SDK — path to the service account JSON downloaded from
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# Nutritionix — https://developer.nutritionix.com
NUTRITIONIX_APP_ID=your_app_id_here
NUTRITIONIX_API_KEY=your_api_key_here

# Model
# Path to the saved Keras model (relative to backend/ or absolute)
MODEL_PATH=../model.keras

# Set to "true" to enable FastAPI debug/reload mode
DEBUG=false
