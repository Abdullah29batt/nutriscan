# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Firebase Admin SDK — path to the service-account JSON downloaded from
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Alternatively set FIREBASE_CREDENTIALS_JSON to the JSON content itself (for Render/Railway).
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

# Google Gemini API key — https://aistudio.google.com/app/apikey  (required)
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the Gemini model used for vision + text
GEMINI_MODEL=gemini-2.5-flash-lite

# Set to "true" to enable debug mode
DEBUG=false
